<Window x:Class="StadiumManagementSystem.Views.EditBookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EditPayment}" Height="300" Width="350"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5"
        FlowDirection="{DynamicResource FlowDirection}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Bookings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Booking.BookingNumber}" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource TotalPrice}"/>
            <TextBlock Text="{Binding Booking.TotalPrice, StringFormat='N0'}" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="{DynamicResource Deposit}"/>
            <TextBox Text="{Binding NewDeposit}" Margin="0,0,0,20" Padding="5"/>

            <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}"
                    Padding="10" Background="#28A745" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="StadiumManagementSystem.Views.EditBookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Payment &amp; History" Height="600" Width="450"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource AddPayment}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <UniformGrid Columns="2">
                <StackPanel>
                    <TextBlock Text="Booking Number:" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.BookingNumber}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Customer:" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.CustomerName}" FontWeight="Bold" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total Price" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.TotalPrice, StringFormat=N0}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Current Balance" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.Balance, StringFormat=N0}" FontWeight="Bold" Foreground="Red" Margin="0,0,0,10"/>
                </StackPanel>
            </UniformGrid>

            <Separator Margin="0,15"/>

            <DockPanel LastChildFill="True" Margin="0,0,0,15">
                <Button DockPanel.Dock="Right" Content="{DynamicResource AddPayment}" Command="{Binding SavePaymentCommand}"
                        Padding="15,5" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="10,0,0,0"/>
                <TextBox Text="{Binding NewPayment}" Padding="10" FontSize="18" FontWeight="Bold" Background="White"/>
            </DockPanel>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="{DynamicResource PaymentHistory}" Margin="0,10">
            <DataGrid ItemsSource="{Binding PaymentHistory}" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=g}" Width="150"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N0}" Width="*"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Print Receipt" Command="{Binding PrintReceiptCommand}"
                    Margin="0,0,5,0" Padding="8" Background="{DynamicResource PrimaryColor}" Foreground="White" BorderThickness="0"/>
            <Button Grid.Column="1" Content="Close" Command="{Binding CancelCommand}"
                    Margin="5,0,0,0" Padding="8" Background="Gray" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="StadiumManagementSystem.Views.EditBookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Payment" Height="400" Width="350"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Update Payment" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Booking Number:" Foreground="Gray"/>
            <TextBlock Text="{Binding Booking.BookingNumber}" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Customer:" Foreground="Gray"/>
            <TextBlock Text="{Binding Booking.CustomerName}" FontWeight="Bold" Margin="0,0,0,10"/>

            <UniformGrid Columns="2" Margin="0,10">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Total Price" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.TotalPrice, StringFormat=N0}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Current Balance" Foreground="Gray"/>
                    <TextBlock Text="{Binding Booking.Balance, StringFormat=N0}" FontWeight="Bold" Foreground="Red"/>
                </StackPanel>
            </UniformGrid>

            <Separator Margin="0,15"/>

            <TextBlock Text="New Payment Amount (YER)" Margin="0,0,0,5"/>
            <TextBox Text="{Binding NewPayment}" Padding="10" FontSize="18" FontWeight="Bold" Background="White"/>

            <Button Content="Add Payment" Command="{Binding SavePaymentCommand}"
                    Margin="0,20,0,0" Padding="12" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0"/>

            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Margin="0,10,0,0" Padding="8" Background="Gray" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="StadiumManagementSystem.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Settings}" FontSize="28" FontWeight="Bold" Foreground="#1F4E78" Margin="0,0,0,20"/>

                <TextBlock Text="{DynamicResource OrganizationName}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.OrganizationName}" Margin="0,0,0,15" Padding="5"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="80" Height="80" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
                    <Image Source="{Binding Settings.LogoPath}"/>
                </Border>
                <Button Grid.Column="1" Content="Upload Logo" Command="{Binding UploadLogoCommand}" VerticalAlignment="Center" Padding="5"/>
            </Grid>

            <TextBlock Text="Stadium 1 Price (YER)" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.Stadium1Price}" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Stadium 2 Price (YER)" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.Stadium2Price}" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="{DynamicResource ManagerName}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.ManagerName}" Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="{DynamicResource Location}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Settings.Location}" Margin="0,0,0,15" Padding="5"/>

                <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}"
                        Padding="10" Background="#1F4E78" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Stadium Management -->
        <Border Grid.Column="1" Background="White" Margin="20,0,0,0" Padding="15" CornerRadius="8" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource StadiumManagement}" FontSize="20" FontWeight="Bold" Foreground="#1F4E78" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Stadiums}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Price/Hr" Binding="{Binding HourlyPrice, StringFormat='N0'}" Width="*"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Command="{Binding DataContext.EditStadiumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="#17A2B8" Foreground="White" BorderThickness="0" Padding="10,2" Margin="2"/>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteStadiumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="#DC3545" Foreground="White" BorderThickness="0" Padding="10,2" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Separator Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="Stadium Name"/>
                            <TextBox Text="{Binding SelectedStadium.Name}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="Price/Hr"/>
                            <TextBox Text="{Binding SelectedStadium.HourlyPrice}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Save Stadium" Command="{Binding SaveStadiumCommand}"
                                Background="#28A745" Foreground="White" Padding="15,5" VerticalAlignment="Bottom" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

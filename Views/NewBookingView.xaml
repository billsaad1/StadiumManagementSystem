<Window x:Class="StadiumManagementSystem.Views.NewBookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NewBooking}" Height="600" Width="450"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5"
        FlowDirection="{DynamicResource FlowDirection}">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Customers}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding CustomerName}" Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="{DynamicResource CustomerPhone}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding CustomerPhone}" Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="{DynamicResource Date}" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding BookingDate}" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource Schedule}" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Stadiums}" SelectedValue="{Binding Stadium}" Margin="0,0,0,15" SelectedValuePath="Name" DisplayMemberPath="Name"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Start Hour (1-24)"/>
                        <TextBox Text="{Binding StartHour}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="End Hour (1-24)"/>
                        <TextBox Text="{Binding EndHour}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="{DynamicResource PaymentMethod}" Margin="0,10,0,5"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="{DynamicResource Deposit}"/>
                        <TextBox Text="{Binding Deposit}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="{DynamicResource Balance}"/>
                        <TextBox Text="{Binding Balance}" Padding="5" IsReadOnly="True" Background="#E9ECEF"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource TotalPrice}" FontSize="18" FontWeight="Bold" Foreground="#28A745"/>
                    <TextBlock Text=": " FontSize="18" FontWeight="Bold" Foreground="#28A745"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='N0'}" FontSize="18" FontWeight="Bold" Foreground="#28A745"/>
                    <TextBlock Text=" YER" FontSize="18" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>

                <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}"
                        Padding="10" Background="#28A745" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

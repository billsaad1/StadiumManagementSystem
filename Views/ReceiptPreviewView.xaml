<Window x:Class="StadiumManagementSystem.Views.ReceiptPreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Height="800" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlowDocumentReader Grid.Row="0" Document="{Binding ReceiptDocument}" ViewingMode="Print"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Print" Command="{Binding PrintCommand}" Width="100" Margin="0,0,10,0" Padding="8" Background="#28A745" Foreground="White" BorderThickness="0"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Width="100" Padding="8" Background="Gray" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

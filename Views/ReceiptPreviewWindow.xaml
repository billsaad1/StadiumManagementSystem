<Window x:Class="StadiumManagementSystem.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Height="600" Width="400"
        WindowStartupLocation="CenterOwner" Background="White"
        FlowDirection="{DynamicResource FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="20">
            <FlowDocumentReader Name="DocReader" ViewingMode="Scroll"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource Print}" Click="Print_Click" Width="100" Margin="5" Padding="5" Background="#28A745" Foreground="White" FontWeight="Bold"/>
            <Button Content="{DynamicResource Close}" Click="Close_Click" Width="100" Margin="5" Padding="5" Background="Gray" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
